@using OrderUp.Client.State
@using OrderUp.Client.Services
@inject CartState Cart
@inject AuthState AuthState
@inject NavigationManager Navigation
@implements IDisposable

@* Mobile Overlay Backdrop *@
@if (!collapseNavMenu)
{
    <div class="navbar-overlay" @onclick="ToggleNavMenu"></div>
}

<nav class="navbar">
    <div class="navbar-inner">
        @* Brand — always left *@
        <a class="navbar-brand" href="">
            <span class="navbar-brand-name">OrderUp</span>
            @if (_isAdminPage)
            {
                <span class="navbar-admin-badge">Admin</span>
            }
        </a>

        @* Desktop Nav Links *@
        <div class="navbar-links">
            @if (!_isAdminPage)
            {
                <NavLink class="navbar-link" href="" Match="NavLinkMatch.All">Menu</NavLink>
                <NavLink class="navbar-link" href="cart">
                    Cart
                    @if (Cart.ItemCount > 0)
                    {
                        <span class="navbar-badge">@Cart.ItemCount</span>
                    }
                </NavLink>
                <NavLink class="navbar-link" href="orders">Orders</NavLink>
            }

            @if (AuthState.IsAdmin)
            {
                <div class="navbar-divider"></div>
                @if (_isAdminPage)
                {
                    <NavLink class="navbar-link" href="admin/orders">Dashboard</NavLink>
                    <NavLink class="navbar-link" href="admin/products">Products</NavLink>
                    <NavLink class="navbar-link" href="admin/addons">Addons</NavLink>
                    <NavLink class="navbar-link" href="admin/reports">Reports</NavLink>
                    <div class="navbar-divider"></div>
                    <NavLink class="navbar-link" href="">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M19 12H5M12 19l-7-7 7-7" /></svg>
                        Menu
                    </NavLink>
                    <button class="navbar-link navbar-signout" @onclick="Logout">Sign out</button>
                }
                else
                {
                    <NavLink class="navbar-link" href="admin/orders">Admin</NavLink>
                }
            }
        </div>

        @* Hamburger — mobile only *@
        <button type="button" class="navbar-toggle" @onclick="ToggleNavMenu" aria-label="Toggle navigation">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            @if (Cart.ItemCount > 0)
            {
                <span class="toggle-badge">@Cart.ItemCount</span>
            }
        </button>
    </div>
</nav>

@* Mobile Slide-in Panel *@
<div class="mobile-nav @(collapseNavMenu ? "collapsed" : "")">
    <button type="button" class="mobile-nav-close" @onclick="ToggleNavMenu" aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
            <path d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>

    <nav class="mobile-nav-links">
        <a href="" class="mobile-nav-link" @onclick="CloseMenuOnNavigate">Menu</a>
        <a href="cart" class="mobile-nav-link" @onclick="CloseMenuOnNavigate">
            Cart
            @if (Cart.ItemCount > 0)
            {
                <span class="mobile-nav-badge">@Cart.ItemCount</span>
            }
        </a>
        <a href="orders" class="mobile-nav-link" @onclick="CloseMenuOnNavigate">Orders</a>

        @if (AuthState.IsAdmin)
        {
            <div class="mobile-nav-divider"></div>
            <div class="mobile-nav-section-label">Admin</div>
            <a href="admin/orders" class="mobile-nav-link-sm" @onclick="CloseMenuOnNavigate">Dashboard</a>
            <a href="admin/products" class="mobile-nav-link-sm" @onclick="CloseMenuOnNavigate">Products</a>
            <a href="admin/addons" class="mobile-nav-link-sm" @onclick="CloseMenuOnNavigate">Addons</a>
            <a href="admin/reports" class="mobile-nav-link-sm" @onclick="CloseMenuOnNavigate">Reports</a>

            <div class="mobile-nav-footer">
                <span class="mobile-nav-email">@AuthState.Email</span>
                <button type="button" class="btn btn-ghost btn-sm mobile-nav-signout" @onclick="Logout">Sign out</button>
            </div>
        }
        else
        {
            <div class="mobile-nav-divider"></div>
            <a href="admin/login" class="mobile-nav-link-sm" @onclick="CloseMenuOnNavigate">Admin Login</a>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private bool _isAdminPage;

    protected override async Task OnInitializedAsync()
    {
        Cart.OnChange += StateHasChanged;
        AuthState.OnChange += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await AuthState.InitializeAsync();
        _isAdminPage = CheckIsAdminPage();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _isAdminPage = CheckIsAdminPage();
        InvokeAsync(StateHasChanged);
    }

    private bool CheckIsAdminPage()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        return relativePath.StartsWith("admin", StringComparison.OrdinalIgnoreCase)
            && !relativePath.StartsWith("admin/login", StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void CloseMenuOnNavigate()
    {
        collapseNavMenu = true;
    }

    private async Task Logout()
    {
        await AuthState.LogoutAsync();
        collapseNavMenu = true;
        Navigation.NavigateTo("/");
    }

    public void Dispose()
    {
        Cart.OnChange -= StateHasChanged;
        AuthState.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
