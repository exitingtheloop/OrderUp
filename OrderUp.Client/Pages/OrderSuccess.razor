@page "/order-success/{OrderId:int}"
@using OrderUp.Client.Services
@using OrderUp.Shared.Contracts.Orders.Responses
@using OrderUp.Shared.Enums
@implements IDisposable
@inject OrdersApi OrdersApi
@inject NavigationManager Navigation

<PageTitle>Order Status</PageTitle>

<div class="container mt-4">
    @if (isLoading)
    {
        <div class="text-center">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2">Loading order details...</p>
        </div>
    }
    else if (order is null)
    {
        <div class="alert alert-danger">
            <h4 class="alert-heading">Order Not Found</h4>
            <p>We couldn't find the order you're looking for.</p>
            <hr>
            <a href="/" class="btn btn-primary">Back to Menu</a>
        </div>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-md-8">
                @* Payment Status Messages *@
                @if (wasCancelled)
                {
                    <div class="alert alert-warning mb-4">
                        <h4 class="alert-heading">
                            <i class="bi bi-exclamation-triangle me-2"></i>Payment Cancelled
                        </h4>
                        <p class="mb-0">Your payment was cancelled. Your order is still unpaid — you can try again below.</p>
                    </div>
                }
                else if (wasPaid && isPolling)
                {
                    <div class="alert alert-info mb-4">
                        <h4 class="alert-heading">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            Confirming Payment...
                        </h4>
                        <p class="mb-0">Please wait while we confirm your payment. This usually takes a few seconds.</p>
                    </div>
                }
                else if (wasPaid && order.PaymentStatus == PaymentStatus.Paid)
                {
                    <div class="alert alert-success mb-4">
                        <h4 class="alert-heading">
                            <i class="bi bi-check-circle me-2"></i>Payment Successful!
                        </h4>
                        <p class="mb-0">Thank you for your order. We're preparing it now.</p>
                    </div>
                }
                else if (wasPaid && !isPolling && order.PaymentStatus == PaymentStatus.Pending)
                {
                    <div class="alert alert-warning mb-4">
                        <h4 class="alert-heading">
                            <i class="bi bi-clock me-2"></i>Payment Processing
                        </h4>
                        <p class="mb-0">Your payment is still being processed. Please refresh in a moment or contact us if this persists.</p>
                    </div>
                }

                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Order #@order.Id</h5>
                        <span class="badge @GetStatusBadgeClass(order.Status)">@order.Status</span>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-sm-6">
                                <strong>Customer:</strong> @order.CustomerName
                            </div>
                            <div class="col-sm-6">
                                <strong>Phone:</strong> @order.CustomerPhone
                            </div>
                        </div>

                        @if (order.PickupTimeUtc.HasValue)
                        {
                            <div class="mb-3">
                                <strong>Pickup Time:</strong> @order.PickupTimeUtc.Value.ToLocalTime().ToString("g")
                            </div>
                        }

                        <hr>

                        <h6>Order Items</h6>
                        <ul class="list-group mb-3">
                            @foreach (var item in order.Items)
                            {
                                <li class="list-group-item">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>@item.Quantity x @item.ProductName</strong>
                                            <span class="text-muted">(@item.VariantName)</span>
                                            @if (item.Addons.Any())
                                            {
                                                <ul class="small text-muted mb-0">
                                                    @foreach (var addon in item.Addons)
                                                    {
                                                        <li>+ @(addon.Quantity > 1 ? $"{addon.Quantity}x " : "")@addon.Name</li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                        <div class="text-end">
                                            ₱@CalculateItemSubtotal(item).ToString("N2")
                                        </div>
                                    </div>
                                </li>
                            }
                        </ul>

                        <div class="d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Total</h5>
                            <h5 class="mb-0">₱@order.Total.ToString("N2")</h5>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong>Payment Status:</strong>
                                <span class="badge @GetPaymentBadgeClass(order.PaymentStatus) ms-2">
                                    @order.PaymentStatus
                                </span>
                                @if (isPolling)
                                {
                                    <span class="spinner-border spinner-border-sm ms-2 text-muted"></span>
                                }
                            </div>

                            @if (order.PaymentStatus == PaymentStatus.Pending && !isPolling)
                            {
                                <button class="btn btn-success" @onclick="PayNow" disabled="@isProcessingPayment">
                                    @if (isProcessingPayment)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    Pay Now
                                </button>
                            }
                        </div>
                    </div>
                    <div class="card-footer text-center">
                        <a href="/" class="btn btn-outline-primary">
                            <i class="bi bi-arrow-left me-1"></i>Back to Menu
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int OrderId { get; set; }

    [SupplyParameterFromQuery(Name = "paid")]
    public int? PaidParam { get; set; }

    [SupplyParameterFromQuery(Name = "cancelled")]
    public int? CancelledParam { get; set; }

    private OrderDto? order;
    private bool isLoading = true;
    private bool isProcessingPayment = false;
    private bool isPolling = false;
    private bool wasPaid => PaidParam == 1;
    private bool wasCancelled => CancelledParam == 1;

    private CancellationTokenSource? _pollCts;
    private const int PollIntervalMs = 2500; // Poll every 2.5 seconds
    private const int MaxPollDurationMs = 20000; // Poll for up to 20 seconds

    [Inject]
    private PaymentsApi PaymentsApi { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrder();

        // If returning from payment provider with ?paid=1, start polling for payment confirmation
        // The webhook might arrive slightly after the redirect
        if (wasPaid && order?.PaymentStatus == PaymentStatus.Pending)
        {
            _ = StartPollingForPaymentConfirmation();
        }
    }

    private async Task LoadOrder()
    {
        isLoading = true;
        try
        {
            order = await OrdersApi.GetOrderAsync(OrderId);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task StartPollingForPaymentConfirmation()
    {
        _pollCts = new CancellationTokenSource();
        isPolling = true;
        StateHasChanged();

        var startTime = DateTime.UtcNow;

        try
        {
            while (!_pollCts.Token.IsCancellationRequested)
            {
                // Check if we've exceeded max poll duration
                if ((DateTime.UtcNow - startTime).TotalMilliseconds > MaxPollDurationMs)
                {
                    break;
                }

                await Task.Delay(PollIntervalMs, _pollCts.Token);

                // Refresh order data
                var refreshedOrder = await OrdersApi.GetOrderAsync(OrderId);
                if (refreshedOrder is not null)
                {
                    order = refreshedOrder;
                    StateHasChanged();

                    // Stop polling if payment is confirmed or failed
                    if (order.PaymentStatus != PaymentStatus.Pending)
                    {
                        break;
                    }
                }
            }
        }
        catch (TaskCanceledException)
        {
            // Polling was cancelled (component disposed)
        }
        finally
        {
            isPolling = false;
            StateHasChanged();
        }
    }

    private async Task PayNow()
    {
        if (order is null) return;

        isProcessingPayment = true;
        try
        {
            var checkoutUrl = await PaymentsApi.CreateCheckoutSessionAsync(order.Id);
            if (!string.IsNullOrEmpty(checkoutUrl))
            {
                // Redirect to payment provider (force full navigation)
                Navigation.NavigateTo(checkoutUrl, forceLoad: true);
            }
        }
        finally
        {
            isProcessingPayment = false;
        }
    }

    private static decimal CalculateItemSubtotal(OrderItemDto item)
    {
        var addonTotal = item.Addons.Sum(a => a.UnitPrice * a.Quantity);
        return (item.BaseUnitPrice + addonTotal) * item.Quantity;
    }

    private static string GetStatusBadgeClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "bg-warning text-dark",
        OrderStatus.Confirmed => "bg-info",
        OrderStatus.Preparing => "bg-primary",
        OrderStatus.Ready => "bg-success",
        OrderStatus.Completed => "bg-secondary",
        OrderStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };

    private static string GetPaymentBadgeClass(PaymentStatus status) => status switch
    {
        PaymentStatus.Pending => "bg-warning text-dark",
        PaymentStatus.Paid => "bg-success",
        PaymentStatus.Failed => "bg-danger",
        PaymentStatus.Refunded => "bg-info",
        _ => "bg-secondary"
    };

    public void Dispose()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
    }
}
