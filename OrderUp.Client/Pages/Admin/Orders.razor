@page "/admin/orders"
@using OrderUp.Client.Services
@using OrderUp.Client.State
@using OrderUp.Client.Components
@using OrderUp.Shared.Contracts.Orders.Responses
@using OrderUp.Shared.Contracts.Orders.Requests
@using OrderUp.Shared.Enums
@implements IDisposable
@inject AdminApi AdminApi
@inject AuthState AuthState
@inject NavigationManager Navigation
@inject AppSettingsService AppSettings

<PageTitle>Admin - Orders</PageTitle>

@if (!isAuthorized)
{
    <LoadingSpinner Size="LoadingSpinner.SpinnerSize.Large" Centered="true" />
}
else
{
    <h1>Today's Orders</h1>

    @if (errorMessage is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (isLoading && orders.Count == 0)
    {
        <p><em>Loading orders...</em></p>
    }
    else if (orders.Count == 0)
    {
        <div class="alert alert-info">No orders today.</div>
    }
    else
    {
        @* Stats Row with Refresh Button *@
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2" data-animate="fade-up">
            <div class="order-stats">
                <strong>Total:</strong> @orders.Count |
                <strong>Pending:</strong> @orders.Count(o => o.Status == OrderStatus.Pending) |
                <strong>In Progress:</strong> @orders.Count(o => o.Status == OrderStatus.Confirmed || o.Status == OrderStatus.Preparing) |
                <strong>Ready:</strong> @orders.Count(o => o.Status == OrderStatus.Ready)
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (_autoRefreshEnabled)
                {
                    <span class="badge bg-success d-flex align-items-center gap-1">
                        <span class="live-dot"></span> Live
                    </span>
                }
                <button class="btn btn-sm @(_autoRefreshEnabled ? "btn-outline-secondary" : "btn-outline-primary")"
                        @onclick="ToggleAutoRefresh"
                        title="@(_autoRefreshEnabled ? "Disable auto-refresh" : "Enable auto-refresh")">
                    @if (_autoRefreshEnabled)
                    {
                        <span>Pause</span>
                    }
                    else
                    {
                        <span>Auto</span>
                    }
                </button>
                <button class="btn btn-sm btn-outline-primary" @onclick="LoadOrders" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8" />
                            <path d="M21 3v5h-5" />
                        </svg>
                    }
                </button>
            </div>
        </div>

        <div class="row" data-animate="fade-up" data-delay="100">
            @foreach (var order in orders.OrderByDescending(o => o.CreatedAtUtc))
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card @GetOrderCardClass(order.Status)">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong>Order #@order.Id</strong>
                            <div class="d-flex gap-2 align-items-center">
                                <a href="/admin/orders/@order.Id/ticket" class="btn btn-sm btn-outline-secondary" title="Print Kitchen Ticket">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <polyline points="6,9 6,2 18,2 18,9"></polyline>
                                        <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
                                        <rect x="6" y="14" width="12" height="8"></rect>
                                    </svg>
                                </a>
                                <span class="badge @GetStatusBadgeClass(order.Status)">@order.Status</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="mb-1"><strong>Customer:</strong> @order.CustomerName</p>
                            <p class="mb-1"><strong>Phone:</strong> @order.CustomerPhone</p>
                            <p class="mb-1"><strong>Time:</strong> @order.CreatedAtUtc.ToLocalTime().ToString("h:mm tt")</p>
                            @if (order.PickupTimeUtc.HasValue)
                            {
                                <p class="mb-1"><strong>Pickup:</strong> @order.PickupTimeUtc.Value.ToLocalTime().ToString("h:mm tt")</p>
                            }
                            <p class="mb-2"><strong>Total:</strong> @AppSettings.CurrencySymbol@order.Total.ToString("N2")</p>

                            <hr />

                            <h6>Items:</h6>
                            <ul class="list-unstyled mb-0">
                                @foreach (var item in order.Items)
                                {
                                    <li class="mb-2">
                                        <strong>@item.Quantity x @item.ProductName (@item.VariantName)</strong>
                                        @if (!string.IsNullOrEmpty(item.Notes))
                                        {
                                            <br />
                                            <small class="text-muted">Note: @item.Notes</small>
                                        }
                                        @if (item.Addons.Any())
                                        {
                                            <ul class="small mb-0">
                                                @foreach (var addon in item.Addons)
                                                {
                                                    <li>+ @addon.Quantity x @addon.Name</li>
                                                }
                                            </ul>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                        <div class="card-footer">
                            @if (order.Status != OrderStatus.Completed && order.Status != OrderStatus.Cancelled)
                            {
                                <div class="d-flex gap-2 flex-wrap">
                                    @foreach (var nextStatus in GetAllowedTransitions(order.Status))
                                    {
                                        <button class="btn btn-sm @GetStatusButtonClass(nextStatus)"
                                                @onclick="() => UpdateOrderStatus(order.Id, nextStatus)"
                                                disabled="@updatingOrderId.HasValue">
                                            @if (updatingOrderId == order.Id)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                            }
                                            @nextStatus
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">@(order.Status == OrderStatus.Completed ? "Completed" : "Cancelled")</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

<style>
    .live-dot {
        width: 8px;
        height: 8px;
        background: #fff;
        border-radius: 50%;
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }
    }
</style>

@code {
    private List<OrderDto> orders = [];
    private bool isLoading = true;
    private bool isAuthorized = false;
    private string? errorMessage;
    private int? updatingOrderId;

    // Auto-refresh
    private bool _autoRefreshEnabled = true;
    private Timer? _refreshTimer;
    private const int RefreshIntervalMs = 10000; // 10 seconds

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();

        if (!AuthState.IsAdmin)
        {
            Navigation.NavigateTo("/admin/login");
            return;
        }

        isAuthorized = true;
        await LoadOrders();
        StartAutoRefresh();
    }

    private void StartAutoRefresh()
    {
        _refreshTimer = new Timer(async _ =>
            {
                if (_autoRefreshEnabled && !isLoading)
                {
                    await InvokeAsync(async () =>
                    {
                        await LoadOrdersSilent();
                        StateHasChanged();
                    });
                }
            }, null, RefreshIntervalMs, RefreshIntervalMs);
    }

    private void ToggleAutoRefresh()
    {
        _autoRefreshEnabled = !_autoRefreshEnabled;
    }

    private async Task LoadOrders()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            orders = await AdminApi.GetTodaysOrdersAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Navigation.NavigateTo("/admin/login");
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load orders: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadOrdersSilent()
    {
        try
        {
            orders = await AdminApi.GetTodaysOrdersAsync();
        }
        catch
        {
            // Silent fail on auto-refresh
        }
    }

    private async Task UpdateOrderStatus(int orderId, OrderStatus newStatus)
    {
        updatingOrderId = orderId;
        errorMessage = null;

        try
        {
            var updated = await AdminApi.UpdateOrderStatusAsync(orderId, new UpdateOrderStatusRequest(newStatus));
            if (updated is not null)
            {
                var index = orders.FindIndex(o => o.Id == orderId);
                if (index >= 0)
                {
                    orders[index] = updated;
                }
            }
        }
        catch (HttpRequestException ex)
        {
            errorMessage = $"Failed to update order: {ex.Message}";
        }
        finally
        {
            updatingOrderId = null;
        }
    }

    private static OrderStatus[] GetAllowedTransitions(OrderStatus current) => current switch
    {
        OrderStatus.Pending => [OrderStatus.Confirmed, OrderStatus.Cancelled],
        OrderStatus.Confirmed => [OrderStatus.Preparing, OrderStatus.Cancelled],
        OrderStatus.Preparing => [OrderStatus.Ready, OrderStatus.Cancelled],
        OrderStatus.Ready => [OrderStatus.Completed],
        _ => []
    };

    private static string GetOrderCardClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "order-card order-card-pending",
        OrderStatus.Confirmed => "order-card order-card-confirmed",
        OrderStatus.Preparing => "order-card order-card-preparing",
        OrderStatus.Ready => "order-card order-card-ready",
        OrderStatus.Completed => "order-card order-card-completed",
        OrderStatus.Cancelled => "order-card order-card-cancelled",
        _ => "order-card"
    };

    private static string GetStatusBadgeClass(OrderStatus status) => status switch
    {
        OrderStatus.Pending => "bg-warning text-dark",
        OrderStatus.Confirmed => "bg-info",
        OrderStatus.Preparing => "bg-primary",
        OrderStatus.Ready => "bg-success",
        OrderStatus.Completed => "bg-secondary",
        OrderStatus.Cancelled => "bg-danger",
        _ => "bg-secondary"
    };

    private static string GetStatusButtonClass(OrderStatus status) => status switch
    {
        OrderStatus.Confirmed => "btn-info",
        OrderStatus.Preparing => "btn-primary",
        OrderStatus.Ready => "btn-success",
        OrderStatus.Completed => "btn-secondary",
        OrderStatus.Cancelled => "btn-outline-danger",
        _ => "btn-secondary"
    };

    public void Dispose()
    {
        _refreshTimer?.Dispose();
    }
}
