@page "/admin/login"
@using OrderUp.Client.State
@using OrderUp.Client.Shared.Ui
@inject AuthState AuthState
@inject NavigationManager Navigation

<PageTitle>Admin Login - OrderUp</PageTitle>

<div class="login-page">
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <h1 class="login-title">Admin Login</h1>
                <p class="login-subtitle">Sign in to manage orders</p>
            </div>

            <div class="login-body">
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <Callout Variant="Callout.CalloutVariant.Danger">@_errorMessage</Callout>
                }

                <EditForm Model="@_loginModel" OnValidSubmit="HandleLogin">
                    <DataAnnotationsValidator />

                    <div class="form-group">
                        <label class="label" for="email">Email</label>
                        <InputText id="email"
                                   class="input"
                                   placeholder="admin@example.com"
                                   @bind-Value="_loginModel.Email" />
                        <ValidationMessage For="@(() => _loginModel.Email)" class="error-text" />
                    </div>

                    <div class="form-group">
                        <label class="label" for="password">Password</label>
                        <InputText id="password"
                                   type="password"
                                   class="input"
                                   placeholder="Your password"
                                   @bind-Value="_loginModel.Password" />
                        <ValidationMessage For="@(() => _loginModel.Password)" class="error-text" />
                    </div>

                    <div class="form-group-inline">
                        <label class="checkbox-label">
                            <InputCheckbox class="checkbox-input" @bind-Value="_loginModel.RememberMe" />
                            <span class="checkbox-text">Remember me</span>
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-lg w-full" disabled="@_isLoggingIn">
                        @if (_isLoggingIn)
                        {
                            <span class="spinner spinner-sm"></span>
                            <span>Signing in...</span>
                        }
                        else
                        {
                            <span>Sign in</span>
                        }
                    </button>
                </EditForm>
            </div>
        </div>

        <div class="login-footer">
            <a href="/" class="back-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                    <path d="M19 12H5M12 19l-7-7 7-7" />
                </svg>
                Back to Menu
            </a>
        </div>
    </div>
</div>

@code {
    private LoginModel _loginModel = new();
    private bool _isLoggingIn = false;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();

        if (AuthState.IsAdmin)
        {
            Navigation.NavigateTo("/admin/orders");
        }
    }

    private async Task HandleLogin()
    {
        _isLoggingIn = true;
        _errorMessage = null;

        try
        {
            var result = await AuthState.LoginAsync(
                     _loginModel.Email,
             _loginModel.Password,
           _loginModel.RememberMe);

            if (result.Success)
            {
                Navigation.NavigateTo("/admin/orders");
            }
            else
            {
                _errorMessage = result.ErrorMessage ?? "Invalid email or password.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoggingIn = false;
        }
    }

    private class LoginModel
    {
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public bool RememberMe { get; set; } = false;
    }
}
