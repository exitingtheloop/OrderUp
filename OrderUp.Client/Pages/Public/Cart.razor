@page "/cart"
@using OrderUp.Client.Services
@using OrderUp.Client.State
@using OrderUp.Client.Components
@using OrderUp.Client.Shared.Ui
@using OrderUp.Shared.Contracts.Orders.Requests
@using OrderUp.Shared.Contracts.Orders.Responses
@using OrderUp.Shared.Enums
@inject CartState CartState
@inject OrdersApi OrdersApi
@inject PaymentsApi PaymentsApi
@inject PendingOrderService PendingOrderService
@inject RecentOrdersService RecentOrdersService
@inject NavigationManager Navigation

<PageTitle>OrderUp - Cart</PageTitle>

<div class="cart-page">
    <header class="page-header">
        <h1 class="page-title">Cart</h1>
    </header>

    @* Unpaid Orders - Subtle Callout *@
    @if (_unpaidOrders.Count > 0)
    {
        <div class="unpaid-orders-callout">
            <Callout Variant="Callout.CalloutVariant.Warning" Title="@(_unpaidOrders.Count == 1 ? "You have an unpaid order" : $"You have {_unpaidOrders.Count} unpaid orders")">
                <div class="unpaid-orders-list">
                    @foreach (var order in _unpaidOrders)
                    {
                        <a href="/order-success/@order.Id" class="unpaid-order-item">
                            <div class="unpaid-order-info">
                                <span class="unpaid-order-id">Order #@order.Id</span>
                                <span class="unpaid-order-date">@order.CreatedAtUtc.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                            </div>
                            <div class="unpaid-order-right">
                                <PriceDisplay Amount="@order.Total" Size="PriceDisplay.PriceSize.Base" />
                                <svg class="chevron-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M9 5l7 7-7 7" />
                                </svg>
                            </div>
                        </a>
                    }
                </div>
            </Callout>
        </div>
    }

    @if (CartState.IsEmpty)
    {
        <EmptyState IconType="EmptyState.EmptyIcon.Cart"
                    Title="Your cart is empty"
                    Description="Browse our menu and add items to get started.">
            <div class="empty-actions">
                <a href="/" class="btn btn-primary btn-md">Browse Menu</a>
                <a href="/orders" class="btn btn-secondary btn-md">View Orders</a>
            </div>
        </EmptyState>
    }
    else
    {
        @* Cart Items *@
        <section class="cart-section">
            <div class="cart-items">
                @foreach (var item in CartState.Items)
                {
                    <div class="cart-item">
                        @*<PlaceholderImage Size="PlaceholderImage.PlaceholderSize.Medium" Alt="@item.ProductName" />*@
                        <img style="height:80px;width:80px" src="@item.ImageUrl"/>
                        <div class="cart-item-content">
                            <div class="cart-item-header">
                                <span class="cart-item-name">@item.ProductName</span>
                                <span class="cart-item-price">
                                    <PriceDisplay Amount="@item.LineTotal" Size="PriceDisplay.PriceSize.Base" />
                                </span>
                            </div>
                            <span class="cart-item-variant">@item.VariantName</span>

                            @if (item.Addons.Count > 0)
                            {
                                <div class="cart-item-addons">
                                    @foreach (var addon in item.Addons)
                                    {
                                        <span class="addon-tag">@(addon.Quantity > 1 ? $"{addon.Quantity}× " : "")@addon.Name</span>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(item.Notes))
                            {
                                <div class="cart-item-notes">"@item.Notes"</div>
                            }

                            <div class="cart-item-controls">
                                <QuantityStepper Value="@item.Quantity"
                                                 Min="1"
                                                 OnChange="(qty) => UpdateQuantity(item, qty)" />
                                <button type="button" class="remove-btn" @onclick="() => RemoveItem(item)">Remove</button>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="cart-summary">
                <div class="cart-total-row">
                    <span class="cart-total-label">Total</span>
                    <PriceDisplay Amount="@CartState.Total()" Size="PriceDisplay.PriceSize.ExtraLarge" />
                </div>
            </div>
        </section>

        @* Customer Information *@
        <section class="form-section">
            <h2 class="section-heading">Your details</h2>

            <div class="form-card">
                <div class="form-group">
                    <label class="label">Name <span class="required">*</span></label>
                    <input type="text"
                           class="input @(string.IsNullOrWhiteSpace(_customerName) && _submitted ? "is-invalid" : "")"
                           placeholder="Your name"
                           @bind="_customerName">
                    @if (string.IsNullOrWhiteSpace(_customerName) && _submitted)
                    {
                        <div class="error-text">Name is required</div>
                    }
                </div>

                <div class="form-group">
                    <label class="label">Phone <span class="required">*</span></label>
                    <input type="tel"
                           class="input @(string.IsNullOrWhiteSpace(_customerPhone) && _submitted ? "is-invalid" : "")"
                           placeholder="Your phone number"
                           @bind="_customerPhone">
                    @if (string.IsNullOrWhiteSpace(_customerPhone) && _submitted)
                    {
                        <div class="error-text">Phone is required</div>
                    }
                </div>

                <div class="form-group">
                    <label class="label">Pickup time <span class="optional">(optional)</span></label>
                    <input type="datetime-local"
                           class="input"
                           min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                           @bind="_pickupTime">
                    <div class="hint">Leave blank for ASAP pickup</div>
                </div>
            </div>
        </section>

        @* Error Message *@
        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <Callout Variant="Callout.CalloutVariant.Danger">@_errorMessage</Callout>
        }

        @* Actions *@
        <div class="page-actions">
            <a href="/" class="btn btn-secondary btn-md">Continue shopping</a>
            <button class="btn btn-primary btn-lg" @onclick="SubmitOrder" disabled="@_submitting">
                @if (_submitting)
                {
                    <span class="spinner spinner-sm"></span>
                    <span>@_submitStatus</span>
                }
                else
                {
                    <span>Place order</span>
                }
            </button>
        </div>
    }
</div>

@code {
    private string? _customerName;
    private string? _customerPhone;
    private DateTime? _pickupTime;
    private bool _submitted;
    private bool _submitting;
    private string? _errorMessage;
    private string _submitStatus = "Processing...";
    private List<OrderDto> _unpaidOrders = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadUnpaidOrders();
            await LoadStoredPhone();
            StateHasChanged();
        }
    }

    private async Task LoadUnpaidOrders()
    {
        var orderIds = await RecentOrdersService.GetOrderIdsAsync();
        var unpaidOrders = new List<OrderDto>();

        foreach (var orderId in orderIds)
        {
            try
            {
                var order = await OrdersApi.GetOrderAsync(orderId);
                if (order?.PaymentStatus == PaymentStatus.Pending)
                {
                    unpaidOrders.Add(order);
                }
            }
            catch { }
        }

        _unpaidOrders = unpaidOrders;
    }

    private async Task LoadStoredPhone()
    {
        if (string.IsNullOrEmpty(_customerPhone))
        {
            _customerPhone = await PendingOrderService.GetStoredPhoneAsync();
        }
    }

    private void UpdateQuantity(CartItem item, int quantity)
    {
        CartState.UpdateQuantity(item, quantity);
    }

    private void RemoveItem(CartItem item)
    {
        CartState.RemoveItem(item);
    }

    private async Task SubmitOrder()
    {
        _submitted = true;
        _errorMessage = null;

        if (string.IsNullOrWhiteSpace(_customerName) || string.IsNullOrWhiteSpace(_customerPhone))
        {
            return;
        }

        _submitting = true;
        _submitStatus = "Creating order...";
        StateHasChanged();

        try
        {
            var request = new CreateOrderRequest(
                CustomerName: _customerName.Trim(),
                CustomerPhone: _customerPhone.Trim(),
                PickupTimeUtc: _pickupTime?.ToUniversalTime(),
                Items: CartState.Items.Select(item => new CreateOrderItemRequest(
                    ProductId: item.ProductId,
                    VariantId: item.VariantId,
                    Quantity: item.Quantity,
                    Notes: item.Notes,
                    Addons: item.Addons.Select(a => new CreateOrderItemAddonRequest(
                        AddonId: a.AddonId,
                        Quantity: a.Quantity
                    )).ToList()
               )).ToList()
            );

            var orderResponse = await OrdersApi.CreateOrderAsync(request);

            if (orderResponse is null)
            {
                _errorMessage = "Failed to create order. Please try again.";
                return;
            }

            var orderId = orderResponse.OrderId;
            await PendingOrderService.SetPendingOrderAsync(orderId, _customerPhone.Trim());
            await RecentOrdersService.AddOrderAsync(orderId);

            _submitStatus = "Redirecting to payment...";
            StateHasChanged();

            var checkoutUrl = await PaymentsApi.CreateCheckoutSessionAsync(orderId);

            if (string.IsNullOrEmpty(checkoutUrl))
            {
                _errorMessage = "Failed to initiate payment. Redirecting to order page...";
                StateHasChanged();
                await Task.Delay(1500);
                CartState.Clear();
                Navigation.NavigateTo($"/order-success/{orderId}");
                return;
            }

            CartState.Clear();
            Navigation.NavigateTo(checkoutUrl, forceLoad: true);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            _submitting = false;
        }
    }
}
