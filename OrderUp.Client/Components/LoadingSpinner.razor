@*
    LoadingSpinner Component
    A simple loading indicator using design system.
*@

<div class="@ContainerClass">
    <div class="spinner @SizeClass"></div>
    @if (!string.IsNullOrEmpty(Message))
    {
        <span class="spinner-message">@Message</span>
    }
</div>

@code {
    [Parameter]
    public SpinnerSize Size { get; set; } = SpinnerSize.Medium;

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public bool Centered { get; set; } = false;

    private string ContainerClass => Centered
     ? "spinner-container spinner-centered"
        : "spinner-container";

    private string SizeClass => Size switch
    {
        SpinnerSize.Small => "spinner-sm",
        SpinnerSize.Medium => "",
        SpinnerSize.Large => "spinner-lg",
        _ => ""
    };

    public enum SpinnerSize
    {
        Small,
        Medium,
        Large
    }
}
