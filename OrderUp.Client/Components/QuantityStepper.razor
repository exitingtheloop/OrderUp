@*
    QuantityStepper Component
    A compact +/- control for adjusting quantities.
 
    Usage:
  <QuantityStepper 
      Value="2" 
        Min="1" 
  Max="10"
  OnChange="HandleQuantityChange" />
*@

<div class="qty-stepper">
    <button type="button"
            class="qty-stepper-btn"
            @onclick="Decrease"
            disabled="@(Value <= Min || Disabled)">
        -
    </button>
    <span class="qty-stepper-value">@Value</span>
    <button type="button"
            class="qty-stepper-btn"
            @onclick="Increase"
            disabled="@(Value >= Max || Disabled)">
        +
    </button>
</div>

@code {
    [Parameter]
    public int Value { get; set; } = 1;

    [Parameter]
    public int Min { get; set; } = 0;

    [Parameter]
    public int Max { get; set; } = 99;

    [Parameter]
    public bool Disabled { get; set; } = false;

    [Parameter]
    public EventCallback<int> OnChange { get; set; }

    private async Task Increase()
    {
        if (Value < Max)
        {
            await OnChange.InvokeAsync(Value + 1);
        }
    }

    private async Task Decrease()
    {
        if (Value > Min)
        {
            await OnChange.InvokeAsync(Value - 1);
        }
    }
}
